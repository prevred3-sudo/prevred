{
  "entities": {
    "Incident": {
      "title": "Incident",
      "description": "Safety incident or field finding submitted from Satellite mobile app or Matrix command center",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "timestamp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 64
        },
        "timeFormatted": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "enum": [
            "Accidente con Baja (LTI)",
            "Accidente sin Baja (FAC/MTC)",
            "Casi Accidente (Near Miss)",
            "Condición Insegura",
            "Acto Inseguro",
            "Emergencia / Conato"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["Leve", "Moderado", "Grave", "Crítico"]
        },
        "status": {
          "type": "string",
          "enum": ["Abierto", "En Investigación", "Acción en Curso", "Cerrado"]
        },
        "reporterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reporterRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reporterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "affectedPerson": {
          "type": "string",
          "maxLength": 120
        },
        "immediateAction": {
          "type": "string",
          "maxLength": 1000
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 700000
        },
        "rootCauseAnalysis": {
          "type": "object",
          "description": "5 Whys analysis map"
        },
        "correctiveActions": {
          "type": "array",
          "description": "CAPA corrective actions bounded to max 25 items"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "code",
        "timestamp",
        "timeFormatted",
        "title",
        "description",
        "location",
        "type",
        "severity",
        "status",
        "reporterName",
        "reporterRole",
        "reporterUid",
        "immediateAction",
        "correctiveActions",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmergencyAlert": {
      "title": "EmergencyAlert",
      "description": "Live SOS emergency state triggered from Satellite or dismissed by Matrix",
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "maxLength": 300
        },
        "triggeredAt": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "triggeredByUid": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["active", "type", "location", "triggeredAt", "message", "triggeredByUid", "updatedAt"]
    },
    "SafetyTalk": {
      "title": "SafetyTalk",
      "description": "Signed safety briefing / talk record submitted from Satellite field app to Matrix",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "timestamp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 64
        },
        "dateFormatted": {
          "type": "string",
          "maxLength": 100
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "talkType": {
          "type": "string",
          "enum": [
            "Charla 5 Minutos",
            "Inducción Terreno",
            "ART / AST Previo",
            "Capacitación Específica"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "instructorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "attendeesCount": {
          "type": "integer"
        },
        "attendeeNames": {
          "type": "array",
          "description": "List of participating workers (bounded to max 50)"
        },
        "notes": {
          "type": "string",
          "maxLength": 1500
        },
        "signatureDataUrl": {
          "type": "string",
          "maxLength": 300000
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500000
        },
        "status": {
          "type": "string",
          "enum": ["Enviada", "Validada Matriz"]
        },
        "reporterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "code",
        "timestamp",
        "dateFormatted",
        "topic",
        "talkType",
        "location",
        "instructorName",
        "attendeesCount",
        "attendeeNames",
        "notes",
        "status",
        "reporterUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registered PRL administrator record",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["role", "createdAt"]
    },
    "WorkerNotification": {
      "title": "WorkerNotification",
      "description": "Real-time safety dispatch or instruction sent from Matrix to Satellite field workers",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "timestamp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 64
        },
        "timeFormatted": {
          "type": "string",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "priority": {
          "type": "string",
          "enum": ["Informativa", "Advertencia", "Urgente"]
        },
        "targetZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "targetWorker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "active": {
          "type": "boolean"
        },
        "acknowledgedBy": {
          "type": "array",
          "description": "Worker names that confirmed receipt (bounded to max 50)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "code",
        "timestamp",
        "timeFormatted",
        "title",
        "message",
        "priority",
        "targetZone",
        "targetWorker",
        "senderName",
        "senderUid",
        "active",
        "acknowledgedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/incidents/{incidentId}": {
      "schema": { "$ref": "#/entities/Incident" },
      "description": "Real-time safety incidents and field reports synchronized between Satellite and Matrix"
    },
    "/safety_talks/{talkId}": {
      "schema": { "$ref": "#/entities/SafetyTalk" },
      "description": "Signed safety talks and field briefings sent from Satellite to Matrix"
    },
    "/worker_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/WorkerNotification" },
      "description": "Real-time safety notices and instructions sent from Matrix to Satellite workers"
    },
    "/emergencies/{emergencyId}": {
      "schema": { "$ref": "#/entities/EmergencyAlert" },
      "description": "Real-time SOS emergency alert state"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "PRL supervisor admin directory"
    }
  }
}
